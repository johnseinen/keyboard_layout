// Single-key transpositions, bidirectional: after <prefix>, <input> <-> <output>.
SWAP(KC_A, KC_E, KC_Y)   // A: E/Y
SWAP(KC_A, KC_Y, KC_E)

SWAP(KC_C, KC_M, KC_R)   // C: M/R
SWAP(KC_C, KC_R, KC_M)

SWAP(KC_C, KC_K, KC_P)   // C: K/P
SWAP(KC_C, KC_P, KC_K)

SWAP(KC_G, KC_V, KC_R)   // G: V/R
SWAP(KC_G, KC_R, KC_V)

SWAP(KC_H, KC_N, KC_T)   // H: N/T
SWAP(KC_H, KC_T, KC_N)

SWAP(KC_L, KC_H, KC_Y)   // L: H/Y
SWAP(KC_L, KC_Y, KC_H)

SWAP(KC_M, KC_B, KC_H)   // M: B/H
SWAP(KC_M, KC_H, KC_B)

SWAP(KC_N, KC_R, KC_Y)   // N: R/Y
SWAP(KC_N, KC_Y, KC_R)

SWAP(KC_N, KC_H, KC_QUOT)   // N: H/'
SWAP(KC_N, KC_QUOT, KC_H)

SWAP(KC_S, KC_C, KC_R)   // S: C/R
SWAP(KC_S, KC_R, KC_C)

SWAP(KC_U, KC_E, KC_O)   // U: E/O
SWAP(KC_U, KC_O, KC_E)

SWAP(KC_W, KC_C, KC_R)   // W: C/R
SWAP(KC_W, KC_R, KC_C)

SWAP(KC_Y, KC_U, KC_DOT)   // Y: U/.
SWAP(KC_Y, KC_DOT, KC_U)

